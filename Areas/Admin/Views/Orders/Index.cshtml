@model IEnumerable<WebBanHang.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<div id="page-wrapper">
    <div class="container-fluid">
        <h1 class="page-header">Orders</h1>
        <div class="panel panel-default">
            <div class="panel-heading">Order List</div>
            <div class="panel-body table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Phone</th>
                            <th>Order Date</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>#@order.Id</td>
                                <td>@order.CustomerName</td>
                                <td>@order.Phone</td>
                                <td>@order.CreatedAt.ToLocalTime().ToString("g")</td>
                                <td>@order.Items.Sum(item => item.UnitPrice * item.Quantity).ToString("N0") ₫</td>
                                <td>
                                    <form asp-area="Admin" asp-controller="Orders" asp-action="UpdateStatus" method="post" class="form-inline">
                                        <input type="hidden" name="id" value="@order.Id">
                                        <select name="status" class="form-control">
                                            @foreach (var status in WebBanHang.Models.OrderStatuses.All)
                                            {
                                                <option value="@status" selected="@(order.Status == status)">@status</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-primary btn-sm">Save</button>
                                    </form>
                                </td>
                                <td>
                                    <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-default btn-sm">Details</a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" class="text-center">No orders found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
