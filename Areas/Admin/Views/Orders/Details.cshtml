@model WebBanHang.Models.Order

@{
    ViewData["Title"] = $"Order Details #{Model.Id}";
}

<div id="page-wrapper">
    <div class="container-fluid">
        <h1 class="page-header">Order Details #@Model.Id</h1>
        <p><strong>Customer:</strong> @Model.CustomerName</p>
        <p><strong>Phone:</strong> @Model.Phone</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Shipping Address:</strong> @Model.ShippingAddress</p>
        <p><strong>Order Date:</strong> @Model.CreatedAt.ToLocalTime().ToString("g")</p>
        <p><strong>Status:</strong> @Model.Status</p>
        <table class="table table-bordered">
            <thead>
                <tr><th>Product</th><th>Unit Price</th><th>Quantity</th><th>Line Total</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.UnitPrice.ToString("N0") ₫</td>
                        <td>@item.Quantity</td>
                        <td>@((item.UnitPrice * item.Quantity).ToString("N0")) ₫</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><th colspan="3">Total</th><th>@Model.Items.Sum(item => item.UnitPrice * item.Quantity).ToString("N0") ₫</th></tr>
            </tfoot>
        </table>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-default">Back</a>
    </div>
</div>
