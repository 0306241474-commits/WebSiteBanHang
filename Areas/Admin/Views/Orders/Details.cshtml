@model WebBanHang.Models.Order

@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.Id}";
}

<div id="page-wrapper">
    <div class="container-fluid">
        <h1 class="page-header">Chi tiết đơn hàng #@Model.Id</h1>
        <p><strong>Khách hàng:</strong> @Model.CustomerName</p>
        <p><strong>Điện thoại:</strong> @Model.Phone</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Địa chỉ giao hàng:</strong> @Model.ShippingAddress</p>
        <p><strong>Ngày đặt:</strong> @Model.CreatedAt.ToLocalTime().ToString("g")</p>
        <p><strong>Trạng thái:</strong> @Model.Status</p>
        <table class="table table-bordered">
            <thead>
                <tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.UnitPrice.ToString("N0") ₫</td>
                        <td>@item.Quantity</td>
                        <td>@((item.UnitPrice * item.Quantity).ToString("N0")) ₫</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><th colspan="3">Tổng</th><th>@Model.Items.Sum(item => item.UnitPrice * item.Quantity).ToString("N0") ₫</th></tr>
            </tfoot>
        </table>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-default">Quay lại</a>
    </div>
</div>
