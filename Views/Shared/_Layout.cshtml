<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Client Website</title>

    <!-- 1. Sửa lại đường dẫn CSS trỏ tới wwwroot/client -->
    <link rel="stylesheet" href="~/client/css/style.css" asp-append-version="true" />
    
    <!-- Cho phép trang con nhúng CSS riêng nếu cần -->
    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Header dùng chung -->
    <header>
        @await Html.PartialAsync("_HeaderPartial") <!-- Có thể tách ra PartialView nếu cần -->
    </header>

    <!-- 2. Nơi nhúng nội dung của các trang con -->
    <main role="main" class="container">
        @RenderBody()
    </main>

    <!-- Footer dùng chung -->
    <footer>
        <p>&copy; 2026 - My Client App</p>
    </footer>

    <!-- 3. Sửa đường dẫn JS -->
    <script src="~/client/js/main.js" asp-append-version="true"></script>
    
    <!-- 4. Nơi nhúng JS riêng của từng trang con -->
    @RenderSection("Scripts", required: false)
</body>
</html>