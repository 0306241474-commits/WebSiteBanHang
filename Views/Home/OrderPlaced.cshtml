@model WebBanHang.Models.Order

@{
    ViewData["Title"] = "Order placed";
}

<section class="section_padding_100">
    <div class="container text-center">
        <h2>Order placed successfully</h2>
        <p>Your order number: <strong>#@Model.Id</strong></p>
        <p>Order status: @Model.Status</p>
        <a asp-controller="Home" asp-action="Index" class="btn karl-btn">Continue shopping</a>
    </div>
</section>
